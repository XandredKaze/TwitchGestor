// Risorse di Silver.exe: icona (anche quella vicino all'orologio), descrizione e manifest.
1 ICON "icon.ico"
1 24 "silver.manifest"
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041004B0"
    BEGIN
      VALUE "CompanyName", "Xandred Kaze"
      VALUE "FileDescription", "Silver"
      VALUE "FileVersion", "1.0.0"
      VALUE "OriginalFilename", "Silver.exe"
      VALUE "ProductName", "Silver"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0410, 1200
  END
END
