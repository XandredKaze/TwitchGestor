# --- Server ---
PORT=3000
# 127.0.0.1 = accessibile solo da questo PC (consigliato). 0.0.0.0 per la rete locale.
HOST=127.0.0.1
# URL pubblico con cui raggiungi il server (serve per il redirect OAuth di Twitch)
PUBLIC_URL=http://localhost:3000
# Se impostato, dashboard e API di controllo richiedono questo token (?token=...)
DASHBOARD_TOKEN=

# --- Twitch (crea l'app su https://dev.twitch.tv/console/apps) ---
# OAuth Redirect URL da registrare nell'app: PUBLIC_URL + /auth/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- StreamElements (donazioni/tips) ---
# Dashboard StreamElements > Account > Channels > Show secrets > JWT Token
STREAMELEMENTS_JWT=

# --- Ko-fi (donazioni) ---
# Ko-fi > Settings > API > Webhooks: URL = PUBLIC_URL + /webhooks/kofi
KOFI_VERIFICATION_TOKEN=

# --- Webhook generico per donazioni (PayPal via Zapier/IFTTT, Streamlabs, ecc.) ---
# POST PUBLIC_URL/webhooks/donation con header "x-webhook-secret: <valore>"
DONATION_WEBHOOK_SECRET=

# --- Solo per test con la Twitch CLI (twitch event websocket start-server) ---
# EVENTSUB_WS_URL=ws://127.0.0.1:8080/ws
# EVENTSUB_API_URL=http://127.0.0.1:8080/eventsub/subscriptions
